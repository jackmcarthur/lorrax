! New 8x8x8 grid; preserve parent SOC patch, magnetic seed and schema symmetry policy.
&control
   prefix = 'fe'
   pseudo_dir = './'
   calculation = 'nscf'
   disk_io = 'low'
/
&system
   ibrav = 3
   celldm(1) = 5.42
   nat = 1
   ntyp = 1
   ecutwfc = 70.0
   nbnd = 312
   occupations = 'smearing'
   smearing = 'fermi-dirac'
   degauss = 0.02
   noncolin = .true.
   lspinorb = .true.
   starting_magnetization(1) = 0.5
   angle1(1) = 0.0
   angle2(1) = 0.0
/
&electrons
   electron_maxstep = 200
   conv_thr = 1.0d-9
   diago_thr_init = 1.0d-10
   mixing_mode = 'plain'
   mixing_beta = 0.25
   mixing_ndim = 8
   diagonalization = 'david'
   diago_david_ndim = 2
   diago_full_acc = .true.
/
ATOMIC_SPECIES
   Fe 55.845 'Fe.upf'
ATOMIC_POSITIONS crystal
   Fe 0.0 0.0 0.0
K_POINTS automatic
 8 8 8 0 0 0
