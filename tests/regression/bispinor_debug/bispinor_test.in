[cohsex]
# Bispinor GN-PPM e2e regression gate (MoS2 3x3, nspinor=2).
# Dynamic GN-PPM Σ_c on the screened charge W plus bare Breit Σ^B folded
# into the sigX column (4 ζ channels, 7 V_q tiles, transverse γ̃
# centroids).  Charge centroid set is NON-orbit-closed (charge tiles run
# full-BZ-direct); the transverse set is orbit-closed (TT tiles take the
# IBZ cascade) — same properties as the original 640/668 fixture.
# ω-grid is deliberately small (9 points).  See README.md for the
# 2026-07-09 shrink + mode change (COHSEX → GN-PPM) and its validation.
#
# ZETA_RCOND IS PINNED, and this is the deck the pin was decided on.  The
# pin is free -- byte-identical between 1e-10 and the shipping default
# (1e-8), so sigma_diag_bispinor_ref.dat is preserved bit for bit -- but
# the margin here is the thinnest in the fixture set.  Full sweep, on the
# 256-centroid charge CCT, max|d| vs the 1e-10 arm:
#
#   rcond      1e-10   1e-9   1e-8(default)   1e-7    1e-6     1e-4
#   n_keep      2304    2304      2304         2108    1679      944
#   dropped        0       0         0          196     625     1360
#   max|d|     (base)  0.000     0.000       42.803  112.649  759.948  meV
#
# The bite threshold is 2.046e-08 against a 1e-8 default: a factor of TWO,
# not a decade.  kappa ~ 4.9e7, the worst-conditioned of the five swept
# decks.  "Safe by 2.05x" is a different sentence from "safe", and what
# erases it is not a change to zeta_rcond at all -- it is any change to
# this fixture that stretches its spectrum slightly.  Note the transverse
# channel is NOT governed by this knob (transverse_zeta_solve defaults to
# `ridge`, not `rank_truncate`); the pin governs the charge channel.
# Measured 2026-08-07, ZETA_RCOND_SWEEP.md; pinned by owner ruling at the
# service-phase landing.  ZETA_RCOND_DEFAULT itself is unchanged.
zeta_rcond = 1e-10
wfn_file = WFN.h5
nval = 4
ncond = 4
nband = 32
sys_dim = 2
bispinor = true
# EXPLICITLY OFF, 2026-08-16.  `use_band_extrapolation` now defaults TRUE and
# hard-refuses `nband < 2*n_occ`; this deck's n_occ is 26 (= WFN nelec), so it
# would need nband >= 52.
#
# HERE THE BAND COUNT CANNOT BE RAISED AT ALL: the fixture WFN.h5 carries only
# 34 bands, against the 52 the gate would want.  Setting the key false is the
# only way this deck runs, and it is also the right answer for what the deck
# measures — the bispinor (SOC, noncolin) Sigma path against a frozen
# reference.  Note this deck is the one where the n_occ-vs-N_electrons mapping
# bites: it is noncolin, so n_occ = N_electrons = 26, not 13.
use_band_extrapolation = false

centroids_file = centroids_frac_256.txt
centroids_file_current = centroids_frac_209_current.txt

memory_per_device_gb = 30.0

restart = false
# EXPLICIT local plan: this is a ONE-GPU deck.  The distributed packed route
# needs a multi-process mesh; naming 'local' keeps this fixture on the
# incumbent route (Sigma^B via
# gw.sigma_x_bispinor, scalar band-diagonal head, NO transverse q=Gamma head),
# which is the route its frozen reference was cut from.  Lane N's dynamic
# packed route needs >= 2x2 GPUs until the packed Dyson solve has a local plan.
linalg = local

do_screened = true
compute_mode = gn_ppm

# Explicit head bypass (no dipole.h5 / eps0mat.h5): both heads = 0.
vhead = 0.0
whead_0freq = 0.0
whead_imfreq = 0.0
# HEAD_CORRECTION EXPLICIT, added 2026-08-23 -- this fixture predates the
# `head_correction` key (default "full" since the low-mem-bands campaign;
# docs/input_reference.md), which is INDEPENDENT of the vhead/whead_*
# bypass above and separately requires dipole.h5
# (gw.qsgw_head.build_dft_head_response). This fixture ships none (its
# own README: "the fixture ships no dipole.h5" -- true of every OTHER
# regression fixture that lacks one too: si_bse_debug, sigma_ppm_gates;
# every fixture that DOES ship a dipole.h5 -- cohsex_debug, gnppm_debug,
# hbn_cohsex_debug, si_cohsex_debug -- was unaffected by the default's
# introduction and so never needed this key). Without this line the
# fresh-fit leg dies at gw_jax.py's `build_dft_head_response` call with
# `FileNotFoundError: head_correction=full requires dipole.h5` before
# Sigma is ever reached -- caught by
# tests/multi_device/bispinor_transverse_vertex_face_gate.py's own
# end-to-end smoke bring-up (KNOWN_LORRAX_ISSUES.md's matching row).
head_correction = off

output_file = sigma_diag_bispinor_test.dat
sigma_diag_file = sigma_diag_bispinor_test.dat

qp_solver = one_shot_dft
use_ppm_sigma = true
screening_method = minimax
ppm_omega_p = 2.0
ppm_fallback_omega = 2.0
sigma_omega_min_ev = -4.0
sigma_omega_max_ev = 4.0
sigma_omega_step_ev = 1.0
sigma_regularization_ev = 0.25
fermi_reference = midgap
