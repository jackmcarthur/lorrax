# Si 4x4x4 SOC, 60-band COHSEX + BSE — rebuild of the 2026-04 BSE record deck.
[cohsex]

restart = false
centroids_file = centroids_frac_480_orbitclosed.txt

# NO `restart_q_storage` KEY — deleted in 0.1.0, storage pinned to the full
# BZ internally.  This deck used to pin `full` explicitly because its
# centroid set is orbit-closed, so `auto` resolved to `ibz` and wrote the
# restart tensors on the q wedge, which the sharded BSE reader
# (`bse_io._MunuSlabPlan`) refuses BY DESIGN — a GW+BSE pipeline at P>1
# broke under that default.  The pin cost nothing (the scripted A/B
# measured auto and full at 0.000000 meV with bit-identical tensors on the
# serial path), and the pinned value is now the only behaviour, so dropping
# the line cannot move a digit of the frozen reference.

nval = 8
ncond = 52
nband = 60
sys_dim = 3
bare_coulomb_cutoff = 25.0

compute_mode = cohsex
bispinor = false
qp_solver = one_shot_dft

screening_method = minimax

# BGW q->0 head scalars (the vcoul body dump from the original run is purged).
vhead = 3303.748102
whead_0freq = 150.395600

memory_per_device_gb = 28

sigma_freq_debug_output = true

wfn_file = WFN.h5
output_file = eqp0_bse.dat
sigma_diag_file = sigma_diag_bse.dat
sigma_omega_h5_file = sigma_mnk.h5

mc_average_vcoul_body = true
zeta_rcond = 1e-10
