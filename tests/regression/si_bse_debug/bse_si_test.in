# Si 4x4x4 SOC, 60-band COHSEX + BSE — rebuild of the 2026-04 BSE record deck.
[cohsex]

restart = false
centroids_file = centroids_frac_480_orbitclosed.txt

# UN-PINNED 2026-08-15, and this deck is now the acceptance test for the fix
# its old comment was waiting on.  The pin said: this deck's centroid set is
# orbit-closed, so `auto` resolves to `ibz` and writes the restart tensors on
# the q WEDGE, and `bse_io._MunuSlabPlan` refused a wedge BY DESIGN, so a
# GW+BSE pipeline at P>1 broke under the default.  The refusal's stated reason
# was COST and the cost had never been measured.
#
# It has been.  4xA100 NVLink, complex128: the unfold runs at 57.4 GiB/s
# against a 2.919 GiB/s disk path, and mu^2 cancels between the bytes moved
# and the bytes saved, so the verdict is a bandwidth ratio and the wedge wins
# by 6-17x at every size.  The sharded reader now unfolds through the same
# `file_io.tagged_arrays._unfold_wedge` the GW leg has used since 536cbac9.
#
# MEASURED ON THIS DECK, P=4, GW+BSE end to end, `auto` vs `full`:
#     isdf_tensors_480.h5   541,335,584 -> 130,299,936 bytes  (4.15x, -392 MB)
#     BSE lowest-8 eigenvalues            BIT-IDENTICAL
#     eqp0.dat / eqp1.dat / sigma_diag    BYTE-IDENTICAL
#
# So `auto` is now both the default and the cheaper arm here, and running this
# deck exercises the wedge transport that used to be unreachable.
restart_q_storage = auto

nval = 8
ncond = 52
nband = 60
sys_dim = 3
bare_coulomb_cutoff = 25.0

do_screened = true
bispinor = false
qp_solver = one_shot_dft

use_ppm_sigma = false
screening_method = minimax

# BGW q->0 head scalars (the vcoul body dump from the original run is purged).
vhead = 3303.748102
whead_0freq = 150.395600

memory_per_device_gb = 28

sigma_freq_debug_output = true
fermi_reference = midgap

wfn_file = WFN.h5
output_file = eqp0_bse.dat
sigma_diag_file = sigma_diag_bse.dat
sigma_omega_h5_file = sigma_mnk.h5

mc_average_vcoul_body = true
zeta_rcond = 1e-10
