# LORRAX 3D COHSEX regression gate — Si 4x4x4 (nosoc, 8 IBZ k-points).
# sys_dim=3 native Coulomb + analytic head path.  BGW head scalars injected
# (vhead / whead_0freq) so the frozen value is anchored to BGW's q->0 head;
# the finite-q body is LORRAX-native (matches BGW-noavg 4*pi/|q+G|^2).
# See reports/cohsex_si_444_gamma_agreement_2026-05-02/ (system agrees with
# BGW COHSEX at 0.12 meV in the full-vcoul-overlay config).
[cohsex]

restart = false
centroids_file = centroids_frac_960.txt

nval = 8
ncond = 52
nband = 60
sys_dim = 3
bare_coulomb_cutoff = 25.0

x_only = false
do_screened = true
bispinor = false
qp_solver = one_shot_dft

use_ppm_sigma = false
screening_method = minimax

# BGW q->0 head overlay (scalars only; no 185 MB vcoul body dump).
vhead = 3303.748102
whead_0freq = 150.395600

use_chunked_isdf = true
memory_per_device_gb = 28

# zeta_rcond DELIBERATELY UNSET -> runs at the production default (1e-8).
# This fixture is the BGW ANCHOR (tests/README.md: "Do not shrink/re-freeze"),
# so it must stay honest against BerkeleyGW (MAE 0.12 meV, max|d| 0.48 meV) and
# not become a LORRAX self-freeze.  Si 4x4x4 / 960 centroids is NOT
# rank-truncation-free: its charge CCT spectrum does extend below the cut.
# Measured drift of sigTOT vs the 1e-10 freeze
# (reports/gw_conduction_postfix_2026-07-21, si_rcond_sweep.sh):
#   rcond    1e-9    1e-8    1e-7    1e-6    1e-5    1e-4
#   max|d|  0.001   0.054   0.417   1.021   2.918  37.218   meV
# The old 1e-6 default cost 1.021 meV -- ABOVE the 0.48 meV BGW max|d| -- which
# is why this fixture used to pin 1e-10.  At the 1e-8 default the drift is
# 0.054 meV, ~9x inside the BGW envelope and ~20x inside the 1e-3 eV gate atol,
# so the pin is no longer needed and the anchor now exercises the SHIPPING
# code path (reports/gw_bandrange_centroids_2026-07-21).

sigma_freq_debug_output = true
sigma_debug_split_contrib = true
fermi_reference = midgap

wfn_file = WFN.h5
output_file = eqp_si_test.dat
sigma_diag_file = eqp_si_test.dat
sigma_omega_h5_file = sigma_mnk.h5
