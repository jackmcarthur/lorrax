# =====================================================================
# LORRAX Si 4x4x4 COHSEX — *** PRODUCTION DECK / THE BERKELEYGW ANCHOR ***
# =====================================================================
# This is the project's ONLY external check against BerkeleyGW.  Every other
# gate in the suite compares LORRAX to LORRAX's own frozen output and is
# therefore structurally blind to the code drifting away from the reference
# implementation.  This deck, paired with `bgw_sigma_hp_noavg.dat`, is what
# closes that hole.
#
# DO NOT SHRINK OR RE-FREEZE THIS DECK to make it faster.  If you want a quick
# Si run, use `cohsex_si_fast.in` (20 bands, 144 centroids, ~12 s) — that is
# exactly what it exists for.  Shrinking this one deletes the anchor: MEASURED,
# the same crystal at 20 bands sits 2109 meV from BerkeleyGW instead of
# 0.64 meV, and no centroid count repairs it (the Coulomb-hole sum runs over
# all `nband` states).  See README.md.
#
# MEASURED agreement, 2026-08-07 at HEAD 04b8bba, full BZ (64 k x 16 bands)
# against bgw_sigma_hp_noavg.dat:
#     x_bare vs BGW X       MAE 0.330 meV   max 1.139
#     sigSX  vs X + (SX-X)  MAE 0.142 meV   max 0.397
#     sigCOH vs CH'         MAE 0.587 meV   max 3.104
#     sigTOT vs Sig'        MAE 0.644 meV   max 2.945
# Note the PRIMED BGW columns: CH'/Sig' are the ones without BGW's static
# remainder (`achcor`), which LORRAX does not compute.  README.md derives this
# from Sigma/write_result_hp.f90:88-100.
#
# sys_dim=3 native Coulomb + analytic head path.  BGW head scalars injected
# (vhead / whead_0freq) so the q->0 head is anchored to BGW; the finite-q body
# is LORRAX-native.
# =====================================================================
[cohsex]

restart = false
centroids_file = centroids_frac_960.txt

nval = 8
ncond = 52
nband = 60
sys_dim = 3
bare_coulomb_cutoff = 25.0

compute_mode = cohsex
bispinor = false
qp_solver = one_shot_dft

screening_method = minimax

# BGW q->0 head overlay (scalars only; no 185 MB vcoul body dump).
vhead = 3303.748102
whead_0freq = 150.395600

memory_per_device_gb = 28

sigma_freq_debug_output = true
fermi_reference = midgap

wfn_file = WFN.h5
output_file = eqp_si_test.dat
sigma_diag_file = eqp_si_test.dat
sigma_omega_h5_file = sigma_mnk.h5

# --- BGW matching convention, pinned 2026-08-06 ------------------------
# This fixture is anchored to D_bgw_cohsex_noavg, i.e. BGW run with
# cell_average_cutoff 1d-12, which averages ONLY the literal q+G=0 element
# (vcoul_generator.f90:101-103) and uses the point 8*pi/|q+G|^2 elsewhere.
# LORRAX default TRUE averages at EVERY q!=0 -- one shell too many.
# MEASURED cost of leaving it unset: sigTOT 141.65 meV MAE vs BGW; with it
# false, 0.43 meV. Pair with BGW default (avgcut=1e12) <-> true.
mc_average_vcoul_body = false

# --- zeta_rcond is PINNED (2026-08-06) ---------------------------------
# CORRECTED 2026-08-07: this block previously claimed the key was
# "DELIBERATELY UNSET -> runs at the production default", while the deck set it
# three lines later.  The deck won; the comment was stale.  It IS pinned, and
# here is why it has to be.
#
# The default moved 1e-10 -> 1e-6 -> 1e-8 AFTER this reference was frozen, so
# it was an unpinned dependency of a pinned anchor and had silently spent
# 5.4e-5 eV of gate margin.  Si 4x4x4 at 960 centroids is NOT
# rank-truncation-free: its charge CCT spectrum extends below the cut.
# Measured drift of sigTOT vs the 1e-10 freeze
# (reports/gw_conduction_postfix_2026-07-21, si_rcond_sweep.sh):
#   rcond    1e-9    1e-8    1e-7    1e-6    1e-5    1e-4
#   max|d|  0.001   0.054   0.417   1.021   2.918  37.218   meV
# Pinning at the freeze value restores byte-identity rather than re-freezing
# against a moving default.
#
# The FAST deck is the opposite case and leaves the key unset: at 144
# centroids the 1e-10 / 1e-9 / 1e-8 / unset arms are BYTE-IDENTICAL, so it can
# exercise the shipping default for free.  See cohsex_si_fast.in.
zeta_rcond = 1e-10
