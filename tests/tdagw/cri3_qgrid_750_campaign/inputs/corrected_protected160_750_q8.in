sc_tol_ev = 0.001
sc_accelerator = anderson
sc_history_depth = 20
sigma_out_of_grid = cover
sigma_regularization_ev = 0.25
sigma_quadrature_eps = 1e-4
restart = false
write_restart_tensors = false
write_wfn_h5 = false
qp_rotations_k_storage = full
centroids_file = /pscratch/sd/j/jackm/sandbox_v2_docs_consolidation_2026-08-14/runs/CrI3/471_monolayer_gnppm_sc_16x16_20260922/12_bseprod_prep/centroids_frac_3000_fit898.txt
