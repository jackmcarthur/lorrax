# Corrected protected-form N750 q8 proper SC; NOT converged.
# Preserve protected160 semicore classification; dipole preparation remains resolved130/30.
# Private native nonconverged seed SHA0734f71b...; not the old GN seed.
[cohsex]
sys_dim = 2
wfn_file = /pscratch/sd/j/jackm/sandbox_v2_docs_consolidation_2026-08-14/runs/CrI3/470_monolayer_pbeU_htransform_20260922/qe/nscf08/WFN.h5
number_bands = 750
zeta_nband = 750
qgrid = 8 8 1
compute_mode = mpa
sigma_w_model = shared_pole
sigma_w_accuracy = production
screening_diagrams = w_rpa
head_correction = full
sc_head_update = dft_velocity
vnl_velocity_sign = +1
linalg = local
bispinor = false
number_bands_protected = 160
qp_solver = self_consistent
density_self_consistent = true
sc_semicore = dft
sc_max_iter = 30
