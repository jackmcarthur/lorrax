&control
   prefix = 'mini_h2_screw'
   pseudo_dir = './'
   outdir = './'
   calculation = 'scf'
   disk_io = 'low'
/
&system
   ibrav = 0
   nat = 2
   ntyp = 1
   ecutwfc = 8.0
   ecutrho = 32.0
   nbnd = 9
   tot_charge = 1.0
   noncolin = .true.
   lspinorb = .true.
   no_t_rev = .true.
   starting_magnetization(1) = 1.0
   angle1(1) = 90.0
   angle2(1) = 90.0
   occupations = 'fixed'
/
&electrons
   electron_maxstep = 200
   conv_thr = 1.0d-8
   mixing_mode = 'plain'
   mixing_beta = 0.2
   diagonalization = 'david'
   diago_david_ndim = 2
   diago_full_acc = .true.
/

ATOMIC_SPECIES
 H 1.00794 'H.upf'
CELL_PARAMETERS bohr
 8.0 0.0 0.0
 0.0 9.0 0.0
 1.0 0.0 10.0
ATOMIC_POSITIONS crystal
 H 0.17 0.00 0.29
 H 0.83 0.50 0.71
K_POINTS automatic
 5 5 1 0 0 0
