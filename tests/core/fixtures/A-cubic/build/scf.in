&control
   prefix = 'core_hdiamond'
   pseudo_dir = './'
   outdir = './'
   calculation = 'scf'
   disk_io = 'low'
/
&system
   ibrav = 0
   nat = 2
   ntyp = 1
   ecutwfc = 15.0
   ecutrho = 60.0
   nbnd = 8
   occupations = 'fixed'
/
&electrons
   electron_maxstep = 80
   conv_thr = 1.0d-10
   mixing_mode = 'plain'
   mixing_beta = 0.5
   diagonalization = 'david'
   diago_david_ndim = 2
   diago_full_acc = .true.
/

ATOMIC_SPECIES
   H 1.00794 'H.upf'

CELL_PARAMETERS bohr
   0.0 3.0 3.0
   3.0 0.0 3.0
   3.0 3.0 0.0

ATOMIC_POSITIONS crystal
   H 0.0000000000 0.0000000000 0.0000000000
   H 0.2500000000 0.2500000000 0.2500000000

K_POINTS automatic
   2 2 2 0 0 0
