[cohsex]
restart = true
centroids_file = centroids_frac_13.txt
nval = 1
ncond = 2
number_bands = 7
sys_dim = 3
compute_mode = mpa
qp_solver = self_consistent
sc_max_iter = 2
sc_tol_ev = 0.5
sc_accelerator = linear
sc_mixing = 1.0
linalg = local
bispinor = false
head_correction = off
mc_average_vcoul_body = false
screening_method = minimax
use_band_extrapolation = false
mpa_n_poles = 2
mpa_sampling_alpha = 1
mpa_pole_batch_size = 2
mpa_overwrite_completed_artifacts = true
sigma_omega_patches_ev = -12:0, 1:12
sigma_omega_step_ev = 1
sigma_regularization_ev = 0.25
sigma_quadrature_eps = 1e-3
sigma_quadrature_reduction_seconds = 20
write_restart_tensors = true
write_qsgw_datasets = true
sigma_freq_debug_output = false
fermi_reference = midgap
wfn_file = WFN.h5
kin_ion_file = kin_ion.h5
sigma_diag_file = mpa_sc1_sigma.dat
eqp0_file = mpa_sc1_eqp0.dat
eqp1_file = mpa_sc1_eqp1.dat
report_file = mpa_sc1.out
sigma_omega_h5_file = mpa_sc1_sigma.h5
