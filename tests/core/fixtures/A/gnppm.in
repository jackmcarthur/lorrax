[cohsex]
restart = true
centroids_file = centroids_frac_21.txt
nval = 2
ncond = 3
number_bands = 7
sys_dim = 3
compute_mode = gn_ppm
qp_solver = one_shot_dft
linalg = local
bispinor = false
head_correction = off
mc_average_vcoul_body = false
screening_method = minimax
use_band_extrapolation = false
sigma_omega_min_ev = -8
sigma_omega_max_ev = 8
sigma_omega_step_ev = 1
sigma_regularization_ev = 0.25
sigma_quadrature_eps = 1e-3
sigma_quadrature_reduction_seconds = 20
write_restart_tensors = true
sigma_freq_debug_output = false
fermi_reference = midgap
wfn_file = WFN.h5
kin_ion_file = kin_ion.h5
sigma_diag_file = gnppm_sigma.dat
eqp0_file = gnppm_eqp0.dat
eqp1_file = gnppm_eqp1.dat
report_file = gnppm.out
sigma_omega_h5_file = gnppm_sigma.h5
