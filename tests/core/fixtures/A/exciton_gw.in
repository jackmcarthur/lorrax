[cohsex]
restart = false
centroids_file = centroids_frac_31_htransform.txt
nval = 2
ncond = 1
number_bands = 7
sys_dim = 3
compute_mode = cohsex
qp_solver = one_shot_dft
linalg = local
bispinor = false
head_correction = off
mc_average_vcoul_body = false
screening_method = minimax
write_restart_tensors = true
sigma_freq_debug_output = false
fermi_reference = midgap
wfn_file = WFN.h5
kin_ion_file = kin_ion.h5
sigma_diag_file = exciton_gw_sigma.dat
eqp0_file = exciton_gw_eqp0.dat
eqp1_file = exciton_gw_eqp1.dat
report_file = exciton_gw.out
sigma_omega_h5_file = exciton_gw_sigma.h5
