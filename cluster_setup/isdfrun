#!/bin/bash
# Simple wrapper for running Python commands in the ISDF Shifter environment
# Usage: isdfrun python3 -m gw_isdf.gw_jax -i gw.inp
#        isdfrun python3 my_script.py
#        ISDF_NTASKS=1 isdfrun python3 -m isdf.isdf_init.kmeans_isdf -i gw.inp

set -euo pipefail

NTASKS="${ISDF_NTASKS:-4}"
CODE_DIR="${ISDF_CODE_DIR:-$HOME/software/isdf_cohsex}"
IMAGE="${ISDF_IMAGE:-nvcr.io/nvidia/jax:25.04-py3}"

if [[ $# -eq 0 ]]; then
    echo "Usage: isdfrun <command> [args...]"
    echo ""
    echo "Examples:"
    echo "  # Inside salloc shell:"
    echo "  isdfrun python3 -m gw_isdf.gw_jax -i gw.inp"
    echo ""
    echo "  # From Cursor/separate terminal (MUST set ISDF_JOBID):"
    echo "  ISDF_JOBID=48182279 isdfrun python3 -m gw_isdf.gw_jax -i gw.inp"
    echo ""
    echo "  # Single-task for kmeans:"
    echo "  ISDF_JOBID=48182279 ISDF_NTASKS=1 isdfrun python3 -m isdf.isdf_init.kmeans_isdf 600"
    echo ""
    echo "Environment variables:"
    echo "  ISDF_JOBID    - Slurm job ID (REQUIRED if running from outside salloc shell)"
    echo "  ISDF_NTASKS   - Number of tasks (default: 4)"
    echo "  ISDF_CODE_DIR - Path to isdf_cohsex repo (default: \$HOME/software/isdf_cohsex)"
    echo "  ISDF_IMAGE    - Shifter image (default: nvcr.io/nvidia/jax:25.04-py3)"
    echo ""
    echo "Find your job ID with: squeue -u \$USER"
    exit 1
fi

# Build srun args
SRUN_ARGS=(-n "$NTASKS")
if [[ -n "${ISDF_JOBID:-}" ]]; then
    SRUN_ARGS+=(--jobid="$ISDF_JOBID")
fi

exec srun "${SRUN_ARGS[@]}" shifter --module=gpu --image="$IMAGE" \
    --env=PYTHONPATH="${CODE_DIR}/src" \
    "$@"

