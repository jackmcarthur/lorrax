[cohsex]
sys_dim = 3
nval = 8                  # every occupied band (8 electrons in spinor bands)
ncond = 20                # Sigma for bands 1-28, as sigma.inp's band_index_max
number_bands = 60         # chi0 and Sigma band sums, as epsilon.inp and sigma.inp
compute_mode = hl_ppm     # Hybertsen-Louie plasmon pole (sigma.x frequency_dependence 1)
ppm_omega_p = 200.0       # HL probe above every chi0 transition: the f-sum limit
use_band_extrapolation = false   # BerkeleyGW truncates the band sum at number_bands
centroids_file = centroids_frac_996.txt   # the table step 1 wrote
bse_k_grid = 10 10 10     # BSE fine grid, as absorption's WFN_fi
