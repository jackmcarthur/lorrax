&control
   calculation = 'scf'
   prefix = 'silicon'
   pseudo_dir = '../../pseudo'
   outdir = './'
/
&system
   ibrav = 0
   nat = 2
   ntyp = 1
   ecutwfc = 25.0
   noncolin = .true.
   lspinorb = .true.
/
&electrons
   conv_thr = 1.0d-10
/
CELL_PARAMETERS angstrom
   2.715  2.715  0.000
   0.000  2.715  2.715
   2.715  0.000  2.715
ATOMIC_SPECIES
   Si  28.086  Si_FR.UPF
ATOMIC_POSITIONS crystal
   Si  -0.125  -0.125  -0.125
   Si   0.125   0.125   0.125
K_POINTS automatic
   8 8 8 0 0 0
