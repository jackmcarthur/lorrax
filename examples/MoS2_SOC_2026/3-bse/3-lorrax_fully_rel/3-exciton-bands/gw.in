[cohsex]
sys_dim = 2
nval = 26
ncond = 22
number_bands = 200
zeta_nband = 200
compute_mode = hl_ppm
ppm_invalid_mode = static_limit
ppm_omega_p = 200.0
mc_average_vcoul_body = false
sigma_omega_min_ev = -65.0
use_band_extrapolation = false
centroids_file = centroids.txt

number_val_bands_fine = 6
number_cond_bands_fine = 8
number_cond_bands_coarse = 22
kgrid_fine = 30 30 1
eqp_co_corrections = eqp_co.dat
dipole_file = dipole.h5
wfn_fi_q_chunk = 128

number_eigenvalues = 64
solver = davidson
davidson_tol_mev = 0.01
solver_max_iter = 200

K_POINTS {crystal_b}
5
0.000000 0.000000 0.000000 1 #G
0.050000 0.000000 0.000000 10
0.500000 0.000000 0.000000 15 #M
0.333333333333 0.333333333333 0.000000 20 #K
0.000000 0.000000 0.000000 20 #G
