# ---------------------------------------------------------------------------
# src/ffi/ — C++/CUDA FFI build tree
# ---------------------------------------------------------------------------
# The generic `build/` above already catches src/ffi/*/cpp/build/, but
# restate explicitly for the FFI subtree and cover IDE / clangd artifacts
# that commonly appear next to the CMakeLists.txt.
src/ffi/**/cpp/build/
src/ffi/**/*.so
src/ffi/**/*.o
src/ffi/**/compile_commands.json
src/ffi/**/.cache/
src/ffi/**/CMakeCache.txt
src/ffi/**/CMakeFiles/
src/ffi/**/cmake_install.cmake
site/
.tier2_cross_p/
.padprobe/
# The HDF5 operation journal and its crash rings (file_io/h5_journal.py).
# Per-rank run artifacts, written into the working directory — which is a
# run directory in production and this checkout when someone runs a driver
# from here.
h5_journal.rank*.log
h5_journal_crash.rank*.txt

# Stray compiler default-output scrap. Do NOT blanket-ignore *.out:
# a tracked reference output may use that suffix.
a.out

# local lane artifacts (config/local/)
.native/
src/ffi/cpp/build_local/
# ...and the host build tree build_ffi_host.sh writes beside it.
src/ffi/cpp/build_host_local/

# tests/hsuite run directories and its compile cache.
.hsuite_runs/
.hsuite_jax_cache/

# user builds (config/perlmutter/build_ffi_{cuda,host}.sh, SLATE stage)
.build/
src/ffi/cpp/build_host/
/cubin_store/
