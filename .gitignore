# ---------------------------------------------------------------------------
# src/ffi/ — C++/CUDA FFI build tree
# ---------------------------------------------------------------------------
# The generic `build/` above already catches src/ffi/*/cpp/build/, but
# restate explicitly for the FFI subtree and cover IDE / clangd artifacts
# that commonly appear next to the CMakeLists.txt.
src/ffi/**/cpp/build/
src/ffi/**/*.so
src/ffi/**/*.o
src/ffi/**/compile_commands.json
src/ffi/**/.cache/
src/ffi/**/CMakeCache.txt
src/ffi/**/CMakeFiles/
src/ffi/**/cmake_install.cmake
site/
.tier2_cross_p/
.restart_q_storage_ab/
.padprobe/
# The HDF5 operation journal and its crash rings (file_io/h5_journal.py).
# Per-rank run artifacts, written into the working directory — which is a
# run directory in production and this checkout when someone runs a driver
# from here.
h5_journal.rank*.log
h5_journal_crash.rank*.txt

# Stray compiler default-output scrap. Do NOT blanket-ignore *.out:
# tracked reference files match it (src/psp/psp_dataclass.out,
# tests/regression/cohsex_debug/sigma_*_ref.out).
a.out

# generic-cloud lane artifacts (config/cloud/)
.native/
src/ffi/cpp/build_cloud/
# ...and the HOST leg's build dir, which config/cloud/build_ffi_host.sh
# creates by default (LORRAX_CLOUD_HOST_BUILD).  It was missing here while
# its CUDA sibling above was listed, so a `git add -A` in this checkout
# swept four ninja/cmake artifacts into a commit (2026-08-27).  The
# `src/ffi/**/CMakeFiles/` and `CMakeCache.txt` rules above catch most of a
# cmake tree but not `build.ninja`, `.ninja_deps`, `.ninja_log` or the
# generated `lorrax_config.h`.
src/ffi/cpp/build_host_cloud/
