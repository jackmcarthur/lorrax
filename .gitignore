# ---------------------------------------------------------------------------
# src/ffi/ — C++/CUDA FFI build tree
# ---------------------------------------------------------------------------
# The generic `build/` above already catches src/ffi/*/cpp/build/, but
# restate explicitly for the FFI subtree and cover IDE / clangd artifacts
# that commonly appear next to the CMakeLists.txt.
src/ffi/**/cpp/build/
src/ffi/**/cpp/build_*/
src/ffi/**/*.so
src/ffi/**/*.o
src/ffi/**/compile_commands.json
src/ffi/**/.cache/
src/ffi/**/CMakeCache.txt
src/ffi/**/CMakeFiles/
src/ffi/**/cmake_install.cmake
site/
.tier2_cross_p/
.restart_q_storage_ab/
.padprobe/
# Stray compiler default-output scrap. Do NOT blanket-ignore *.out:
# tracked reference files match it (src/psp/psp_dataclass.out,
# tests/regression/cohsex_debug/sigma_*_ref.out).
a.out
